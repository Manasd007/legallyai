DEEPGRAM_API_KEY=
GROQ_API_KEY=

RAG_BASE_URL=http://localhost:8000

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# WebRTC ICE. STUN alone works on open networks; a TURN relay is required on
# hosts without inbound UDP (e.g. HF Spaces) or behind symmetric NAT. Get free
# TURN creds from metered.ca (or Twilio). Blank TURN_URL = STUN only.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

