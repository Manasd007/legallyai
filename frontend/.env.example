# Frontend env (copy to frontend/.env.local)
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Legally AI Voice service origin. Unset = the mic button is hidden.
# NEXT_PUBLIC_VOICE_URL is inlined at build time; VOICE_URL is read at runtime by
# /voice-config (prefer it on a deploy so the button appears without a rebuild).
NEXT_PUBLIC_VOICE_URL=http://localhost:7860
# VOICE_URL=https://your-voice-space.hf.space
# WebRTC ICE for voice calls — TURN creds must match the voice service's. Blank TURN = STUN only.
NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
